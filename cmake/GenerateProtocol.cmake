# Command identifiers come from protocol.json; state constants from etats.csv.
set(protocol_file "${CMAKE_CURRENT_SOURCE_DIR}/resources/protocol.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${protocol_file}")
file(READ "${protocol_file}" protocol_json)
string(JSON root_type TYPE "${protocol_json}")
if(NOT root_type STREQUAL "ARRAY")
    message(FATAL_ERROR "protocol.json: expected an array of key/cmd objects")
endif()
string(JSON count LENGTH "${protocol_json}")
if(count LESS 1)
    message(FATAL_ERROR "protocol.json: no commands defined")
endif()
set(command_keys "")
math(EXPR last "${count} - 1")
foreach(index RANGE 0 ${last})
    string(JSON key_type TYPE "${protocol_json}" ${index} key)
    string(JSON key GET "${protocol_json}" ${index} key)
    string(JSON cmd_type TYPE "${protocol_json}" ${index} cmd)
    string(JSON cmd GET "${protocol_json}" ${index} cmd)
    if(NOT key_type STREQUAL "STRING" OR NOT key MATCHES "^[A-Za-z_][A-Za-z0-9_]*$" OR key IN_LIST command_keys)
        message(FATAL_ERROR "protocol.json: invalid or duplicate key at index ${index}")
    endif()
    if(NOT cmd_type STREQUAL "STRING" OR cmd STREQUAL "" OR cmd MATCHES "[\r\n\t]")
        message(FATAL_ERROR "protocol.json: invalid cmd for ${key}")
    endif()
    list(APPEND command_keys "${key}")
endforeach()
list(SORT command_keys)
set(command_header "// Generated from resources/protocol.json. Do not edit.\n#pragma once\n#include <QString>\n#include <QMetaType>\n#include <optional>\nnamespace Protocol {\nenum class CMD {\n")
foreach(key IN LISTS command_keys)
    string(APPEND command_header "    ${key},\n")
endforeach()
string(APPEND command_header "};\ninline QString commandName(CMD command) {\n    switch (command) {\n")
foreach(key IN LISTS command_keys)
    string(APPEND command_header "    case CMD::${key}: return QStringLiteral(\"${key}\");\n")
endforeach()
string(APPEND command_header "    }\n    return {};\n}\ninline std::optional<CMD> commandId(const QString &name) {\n")
foreach(key IN LISTS command_keys)
    string(APPEND command_header "    if (name == QStringLiteral(\"${key}\")) return CMD::${key};\n")
endforeach()
string(APPEND command_header "    return std::nullopt;\n}\n}\nQ_DECLARE_METATYPE(Protocol::CMD)\n")
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/generated/serial")
file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/generated/serial/CommandIds.h" CONTENT "${command_header}" @ONLY)
set(protocol_header "// Generated from resources/etats.csv. Do not edit.\n#pragma once\n#include \"serial/Commands.h\"\nnamespace Protocol {\n")
set(states_file "${CMAKE_CURRENT_SOURCE_DIR}/resources/etats.csv")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${states_file}")
file(STRINGS "${states_file}" state_lines ENCODING UTF-8)
string(APPEND protocol_header "namespace Etat {\n")
set(state_keys "")
set(state_values "")
foreach(line IN LISTS state_lines)
    string(STRIP "${line}" line)
    if(line STREQUAL "" OR line MATCHES "^#")
        continue()
    endif()
    set(fields "${line}")
    list(LENGTH fields field_count)
    if(NOT field_count EQUAL 4)
        message(FATAL_ERROR "etats.csv: expected TYPE;ETAT;VALEUR;NOM: ${line}")
    endif()
    list(GET fields 0 machine)
    list(GET fields 1 state)
    list(GET fields 2 value)
    list(GET fields 3 name)
    string(STRIP "${machine}" machine)
    string(STRIP "${state}" state)
    string(STRIP "${value}" value)
    string(STRIP "${name}" name)
    if(NOT machine MATCHES "^[A-Z_][A-Z0-9_]*$" OR NOT state MATCHES "^[A-Z_][A-Z0-9_]*$"
       OR NOT value MATCHES "^(0|[1-9][0-9]*)$" OR name STREQUAL "")
        message(FATAL_ERROR "etats.csv: invalid state: ${line}")
    endif()
    if(value GREATER 2147483647)
        message(FATAL_ERROR "etats.csv: value exceeds qint32: ${line}")
    endif()
    set(key "${machine}_${state}")
    if(key IN_LIST state_keys OR value IN_LIST state_values)
        message(FATAL_ERROR "etats.csv: duplicate identifier or value: ${line}")
    endif()
    list(APPEND state_keys "${key}")
    list(APPEND state_values "${value}")
    string(APPEND protocol_header "inline constexpr int ${key} = ${value};\n")
endforeach()
if(NOT state_keys)
    message(FATAL_ERROR "etats.csv: no states defined")
endif()
string(APPEND protocol_header "}\n")
string(APPEND protocol_header "}\n")
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/generated/serial")
file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/generated/serial/Protocol.h"
    CONTENT "${protocol_header}" @ONLY)
